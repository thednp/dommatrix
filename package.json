{
  "name": "@thednp/dommatrix",
  "version": "3.1.4",
  "description": "TypeScript shim for DOMMatrix",
  "keywords": [
    "css",
    "cssmatrix",
    "dom",
    "dommatrix",
    "nodejs",
    "polyfill",
    "shim",
    "transform",
    "typescript"
  ],
  "homepage": "https://thednp.github.io/dommatrix/",
  "bugs": {
    "url": "https://github.com/thednp/dommatrix/issues"
  },
  "license": "MIT",
  "author": "thednp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thednp/dommatrix.git"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/dommatrix.js",
  "module": "./dist/dommatrix.mjs",
  "exports": {
    ".": {
      "types": "./dist/dommatrix.d.ts",
      "require": "./dist/dommatrix.cjs",
      "import": "./dist/dommatrix.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "pre-test": "vpr clean-coverage",
    "test": "vpr pre-test && vp test --browser.headless",
    "test-ui": "vpr pre-test && vp test --browser --ui --watch",
    "bench": "vp test --browser.headless --coverage.enabled=false test/dommatrix.bench.test.ts",
    "bench:native": "vp test --browser.headless --coverage.enabled=false test/native.bench.test.ts",
    "bench:docs": "vpx scripts/update-benchmark.js",
    "clean-coverage": "rm -rf coverage .nyc_output",
    "format": "vp fmt src",
    "lint": "vpr lint:ts && vpr check:ts",
    "lint:ts": "vp lint src",
    "check:ts": "tsc --noEmit",
    "fix:ts": "vp lint src --fix",
    "build": "vp pack && vpr copy-docs",
    "up:deno": "deno update --latest && deno run -A scripts/update-deno.js",
    "copy-docs": "cp dist/dommatrix.js docs/dommatrix.js && cp dist/dommatrix.js.map docs/dommatrix.js.map",
    "prepublishOnly": "vp up --latest && vpr format && vpr lint && vpr build && vpr up:deno",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}